def kruskal(edges,n):
    edges.sort(key=lambda x:x[2])
    parent=list(range(n))

    def find(x):
        while parent[x]!=x:
            x=parent[x]
        return x

    cost=0
    mst=[]

    for u,v,w in edges:
        pu=find(u)
        pv=find(v)

        if pu!=pv:
            parent[pu]=pv
            cost+=w
            mst.append((u,v,w))

    print("MST Cost =",cost)
    print("Edges =",mst)

edges=[(0,1,10),(0,2,6),(0,3,5),(1,3,15),(2,3,4)]

kruskal(edges,4)